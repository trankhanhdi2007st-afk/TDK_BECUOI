@model TKD_BECUOI.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
}

<h2 class="mb-4">CHI TIẾT ĐƠN HÀNG</h2>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">
        @TempData["ThongBao"]
    </div>
}

<div class="admin-card mb-4">

    <div class="d-flex justify-content-between align-items-center">
        <h5>Thông tin đơn hàng #@Model.OrderID</h5>

        <span class="badge bg-primary">
            @Model.OrderStatus
        </span>
    </div>

    <hr />

    <div class="row">
        <div class="col-md-6">
            <p>
                <strong>Mã đơn hàng:</strong>
                @Model.OrderID
            </p>

            <p>
                <strong>Ngày đặt hàng:</strong>
                @Model.OrderDate.ToString("dd/MM/yyyy")
            </p>

            <p>
                <strong>Trạng thái đơn hàng:</strong>
                @Model.OrderStatus
            </p>

            <p>
                <strong>Trạng thái thanh toán:</strong>
                @Model.PaymentStatus
            </p>
        </div>

        <div class="col-md-6">
            <p>
                <strong>Khách hàng:</strong>
                @(Model.Customer != null
                    ? Model.Customer.CustomerName
                    : "Không có thông tin")
            </p>

            <p>
                <strong>Số điện thoại:</strong>
                @(Model.Customer != null
                    ? Model.Customer.CustomerPhone
                    : "")
            </p>

            <p>
                <strong>Email:</strong>
                @(Model.Customer != null
                    ? Model.Customer.CustomerEmail
                    : "")
            </p>

            <p>
                <strong>Địa chỉ giao hàng:</strong>
                @Model.AddressDelivery
            </p>
        </div>

    </div>

    <hr />

    <p>
        <strong>Phương thức thanh toán:</strong>
        @Model.PaymentMethod
    </p>

    <p>
        <strong>Phương thức giao hàng:</strong>
        @Model.DeliveryMethod
    </p>

    <h5 class="mt-4">Danh sách sản phẩm</h5>

    <div class="table-responsive">

        <table class="table table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Mã sản phẩm</th>
                    <th>Tên sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.OrderDetail != null && Model.OrderDetail.Any())
                {
                    foreach (var item in Model.OrderDetail)
                    {
                        <tr>
                            <td>@item.ProductID</td>

                            <td>
                                @(item.Product != null
                                    ? item.Product.ProductName
                                    : "Sản phẩm không tồn tại")
                            </td>

                            <td>
                                @String.Format("{0:N0} VNĐ", item.UnitPrice)
                            </td>

                            <td>@item.Quantity</td>

                            <td>
                                @String.Format(
                                              "{0:N0} VNĐ",
                                              item.UnitPrice * item.Quantity
                                          )
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            Đơn hàng chưa có sản phẩm.
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

    <div class="text-end">
        <h4 class="text-danger">
            Tổng tiền:
            @String.Format("{0:N0} VNĐ", Model.TotalAmount)
        </h4>
    </div>

    <hr />

    <div class="d-flex gap-2">

        <a href="@Url.Action("UpdateStatus", "Orders",
            new { area = "Admin", id = Model.OrderID })"
           class="btn btn-warning">
            Cập nhật trạng thái
        </a>

        <a href="@Url.Action("Index", "Orders", new { area = "Admin" })"
           class="btn btn-secondary">
            Quay lại danh sách
        </a>

    </div>

</div>