```cshtml
@model IEnumerable<TKD_BECUOI.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
}

<h2 class="mb-4">QUẢN LÝ ĐƠN HÀNG</h2>

<div class="admin-card mb-4">

    <h5 class="mb-3">Tìm kiếm đơn hàng</h5>

    @using (Html.BeginForm("Index", "Orders", FormMethod.Get,
        new { area = "Admin" }))
    {
        <div class="row g-3">

            <div class="col-md-4">
                <label class="form-label">Tên khách hàng</label>

                <input type="text"
                       name="tenKhachHang"
                       class="form-control"
                       value="@ViewBag.TenKhachHang"
                       placeholder="Nhập tên khách hàng..." />
            </div>

            <div class="col-md-4">
                <label class="form-label">Trạng thái thanh toán</label>

                <select name="trangThaiThanhToan" class="form-select">
                    <option value="">-- Tất cả --</option>

                    <option value="Đã thanh toán"
                            @(ViewBag.TrangThaiThanhToan == "Đã thanh toán" ? "selected" : "")>
                        Đã thanh toán
                    </option>

                    <option value="Chưa thanh toán"
                            @(ViewBag.TrangThaiThanhToan == "Chưa thanh toán" ? "selected" : "")>
                        Chưa thanh toán
                    </option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Ngày đặt hàng</label>

                <input type="date"
                       name="ngayDatHang"
                       class="form-control"
                       value="@ViewBag.NgayDatHang" />
            </div>

        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                Tìm kiếm
            </button>

            <a href="@Url.Action("Index", "Orders", new { area = "Admin" })"
               class="btn btn-secondary">
                Làm mới
            </a>
        </div>
    }

</div>

<div class="admin-card">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">DANH SÁCH ĐƠN HÀNG</h5>

        <span class="badge bg-primary">
            Tổng: @ViewBag.TongSoDon đơn hàng
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">
            <strong>KHÔNG CÓ</strong>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái đơn</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OrderID</td>

                            <td>
                                @(item.Customer != null
                                    ? item.Customer.CustomerName
                                    : "Không có thông tin")
                            </td>

                            <td>
                                @item.OrderDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @String.Format("{0:N0} VNĐ", item.TotalAmount)
                            </td>

                            <td>
                                @item.PaymentStatus
                            </td>

                            <td>
                                @item.OrderStatus
                            </td>

                            <td>
                                <a href="@Url.Action("DetailedOrder", "Orders",
                                    new { area = "Admin", id = item.OrderID })"
                                   class="btn btn-sm btn-info text-white">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <!-- Phân trang -->
        <div class="d-flex justify-content-center align-items-center gap-2 mt-3">

            @if (ViewBag.TrangHienTai > 1)
            {
                <a class="btn btn-outline-primary"
                   href="@Url.Action("Index", new {
                       area = "Admin",
                       trang = ViewBag.TrangHienTai - 1,
                       tenKhachHang = ViewBag.TenKhachHang,
                       trangThaiThanhToan = ViewBag.TrangThaiThanhToan,
                       ngayDatHang = ViewBag.NgayDatHang
                   })">
                    Trước
                </a>
            }

            <span>
                Trang @ViewBag.TrangHienTai / @ViewBag.TongSoTrang
            </span>

            @if (ViewBag.TrangHienTai < ViewBag.TongSoTrang)
            {
                <a class="btn btn-outline-primary"
                   href="@Url.Action("Index", new {
                       area = "Admin",
                       trang = ViewBag.TrangHienTai + 1,
                       tenKhachHang = ViewBag.TenKhachHang,
                       trangThaiThanhToan = ViewBag.TrangThaiThanhToan,
                       ngayDatHang = ViewBag.NgayDatHang
                   })">
                    Tiếp
                </a>
            }

        </div>
    }

</div>
```