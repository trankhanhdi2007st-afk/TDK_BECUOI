
@{
    ViewBag.Title = "Đăng ký";
}

<style>
    .account-card {
        max-width: 430px;
        margin: 55px auto;
        padding: 35px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 5px 25px rgba(0,0,0,.08);
    }

        .account-card h2 {
            text-align: center;
            font-weight: bold;
            color: #1d1d1f;
            margin-bottom: 8px;
        }

    .account-subtitle {
        text-align: center;
        color: #86868b;
        margin-bottom: 28px;
    }

    .account-card label {
        font-weight: 600;
    }

    .account-card .form-control {
        height: 45px;
        border-radius: 8px;
        margin-bottom: 18px;
    }

    .account-btn {
        width: 100%;
        padding: 12px;
        background: #0071e3;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        margin-bottom: 12px;
    }

        .account-btn:hover {
            background: #005bb5;
            color: white;
        }

    .account-link {
        display: block;
        text-align: center;
        margin-top: 15px;
    }
</style>

<div class="container" style="max-width:430px; margin:50px auto;">
    <div class="panel panel-default"
         style="padding:30px; border-radius:15px;">

        <h2 class="text-center">Tạo tài khoản mới</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm(
            "Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input type="text"
                       name="username"
                       class="form-control"
                       minlength="3"
                       placeholder="Tối thiểu 3 ký tự"
                       required />
            </div>

            <div class="form-group">
                <label>Mật khẩu</label>
                <input type="password"
                       id="password"
                       name="password"
                       class="form-control"
                       minlength="6"
                       placeholder="Tối thiểu 6 ký tự"
                       required />
            </div>

            <div class="form-group">
                <label>Xác nhận mật khẩu</label>
                <input type="password"
                       name="confirmPassword"
                       class="form-control"
                       placeholder="Nhập lại mật khẩu"
                       required />
            </div>

            <button type="submit"
                    class="btn btn-primary btn-block">
                Tạo tài khoản
            </button>

            <p class="text-center" style="margin-top:15px;">
                Đã có tài khoản?
                @Html.ActionLink(
                         "Đăng nhập", "Login", "Account")
            </p>

            <p class="text-center">
                @Html.ActionLink(
                         "Quay lại trang chủ", "Index", "Home")
            </p>
        }
    </div>
</div>