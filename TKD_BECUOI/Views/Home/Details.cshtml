
@model TKD_BECUOI.Models.Product

@{
    ViewBag.Title = Model.ProductName;
}

<style>
    .detail-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
    }

    .detail-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        background: white;
        padding: 30px;
        border-radius: 18px;
    }

    .detail-image {
        width: 100%;
        height: 420px;
        object-fit: contain;
    }

    .detail-info h1 {
        font-size: 30px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .detail-price {
        color: #e53935;
        font-size: 28px;
        font-weight: bold;
        margin: 25px 0;
    }

    .detail-description {
        line-height: 1.8;
        color: #555;
        white-space: pre-line;
    }

    .back-button {
        display: inline-block;
        padding: 12px 22px;
        background: #0071e3;
        color: white;
        border-radius: 9px;
        text-decoration: none;
        margin-top: 25px;
    }

        .back-button:hover {
            color: white;
            text-decoration: none;
            background: #005bb5;
        }

    @@media(max-width: 700px) {
        .detail-box {
            grid-template-columns: 1fr;
        }

        .detail-image {
            height: 280px;
        }
    }
</style>

<div class="detail-container">
    <div class="detail-box">

        <div>
            @if (!String.IsNullOrEmpty(Model.ProductImage))
            {
                <img src="@Model.ProductImage"
                     class="detail-image"
                     alt="@Model.ProductName" />
            }
            else
            {
                <img src="https://placehold.co/500x400?text=No+Image"
                     class="detail-image"
                     alt="Không có ảnh" />
            }
        </div>

        <div class="detail-info">

            <h1>@Model.ProductName</h1>

            <p>
                Danh mục:
                <strong>
                    @(Model.Category != null
                        ? Model.Category.CategoryName
                        : "Chưa phân loại")
                </strong>
            </p>

            <div class="detail-price">
                @String.Format("{0:N0} ₫", Model.ProductPrice)
            </div>
            @using (Html.BeginForm("Add", "Cart", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="productID"
                       value="@Model.ProductID" />

                <button type="submit"
                        class="btn btn-success btn-lg"
                        style="margin:15px 0; width:100%;">
                    <i class="glyphicon glyphicon-shopping-cart"></i>
                    THÊM VÀO GIỎ HÀNG
                </button>
            }

            <a href="@Url.Action("Index", "Cart")"
               class="btn btn-warning btn-lg"
               style="width:100%;">
                XEM GIỎ HÀNG
            </a>

            @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.ProductID" />

                <button type="submit"
                        style="background:#0071e3;
                   color:white;
                   padding:14px 25px;
                   border:none;
                   border-radius:8px;
                   font-weight:bold;
                   cursor:pointer;">
                    Thêm vào giỏ hàng
                </button>
            }


            <h4>Mô tả sản phẩm</h4>

            <div class="detail-description">
                @(String.IsNullOrEmpty(Model.ProductDecription)
                    ? "Chưa có mô tả sản phẩm."
                    : Model.ProductDecription)
            </div>

            <a href="@Url.Action("Index", "Home")"
               class="back-button">
                ← Quay lại mua sắm
            </a>

        </div>
    </div>
</div>
