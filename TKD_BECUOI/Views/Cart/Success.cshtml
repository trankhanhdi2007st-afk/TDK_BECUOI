@{
    ViewBag.Title = "Đặt hàng thành công";
}

<div class="container text-center" style="margin-top:60px;">

    <h2 class="text-success">ĐẶT HÀNG THÀNH CÔNG!</h2>

    <p>Mã đơn hàng của bạn là:</p>

    <h3 class="text-danger">#@ViewBag.MaDonHang</h3>

    <a href="@Url.Action("Index", "Home")"
       class="btn btn-primary">
        Tiếp tục mua sắm
    </a>

    <a href="@Url.Action("Index", "MyOrder")"
       class="btn btn-success">
        Lịch sử mua hàng
    </a>
</div>